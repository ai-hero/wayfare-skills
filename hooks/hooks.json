{
  "description": "wayfare: catch deferred work that was never filed in .plans/, and warn when a fleet tool is below its version floor",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-deferrals.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-floors.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
